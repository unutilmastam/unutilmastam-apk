<resources>
    <style name="Theme.UnutilmasTam" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.UnutilmasTam.Splash" parent="Theme.UnutilmasTam">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
